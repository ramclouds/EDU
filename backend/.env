# Local development settings (backend). Edit values here, then restart: python app.py

# Database: your local MySQL. Change user/password if yours differ.
MYSQL_DSN=mysql+pymysql://root:@127.0.0.1/edu_school
FLASK_ENV=development
APP_SECRET_KEY=da52a023633dbd64910a05b4a6b8fe21d68e6afcce040125eca1cce07e61885c
TOKEN_EXPIRY_HOURS=12

# Frontend origin allowed to call the API
CORS_ORIGINS=http://localhost:5173

# School addresses on your laptop: http://<school>.localhost:5173
TENANT_BASE_DOMAIN=localhost
TENANT_URL_SCHEME=http
TENANT_PUBLIC_PORT=5173
TENANT_DB_PREFIX=edu
API_DEFAULT_VERSION=y26
TENANT_POOL_SIZE=5
TENANT_MAX_OVERFLOW=5
TENANT_CACHE_SECONDS=30

# Login protection (failed attempts only)
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILS_PER_ACCOUNT=8
LOGIN_MAX_FAILS_PER_IP=100
LOGIN_FAIL_WINDOW_SECONDS=300

# Email: encryption key for stored SMTP passwords. Keep it; losing it means re-entering passwords.
SMTP_ENCRYPTION_KEY=NPYlDSfaGO_YHYbFgBe6F4eyaAb46MlbxP6qroCRbWE=
# Development only: allows a local mail catcher and unencrypted mail connections
SMTP_ALLOW_LOCAL=true

BRANDING_UPLOAD_DIR=
