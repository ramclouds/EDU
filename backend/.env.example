# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed — it's in .gitignore.

# --- Database ---
MYSQL_DSN=mysql+pymysql://USER:PASSWORD@HOST:3306/edu_school

# --- Environment ---
# development | production
# production disables the Werkzeug debugger, requires APP_SECRET_KEY,
# and skips db.create_all() in favor of real migrations.
FLASK_ENV=development

# --- Secret key ---
# Used for Flask's signed cookies/sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required (app refuses to start without it) when FLASK_ENV=production.
APP_SECRET_KEY=

# --- Sessions ---
# How long an issued login token stays valid without activity, in hours.
TOKEN_EXPIRY_HOURS=12

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- Multi-tenancy (database per school) ---
# Base domain: YOUR OWN domain, for example example.com (no http://, no tenant_id).
# A request to <tenant_id>.api.<this> or <tenant_id>.login.<this>
# selects the school whose School.tenant_id equals <tenant_id>.
# Leave empty for local development: school_code at login then selects the school.
TENANT_BASE_DOMAIN=
# Prefix for school database names (edu_sch_xxxxxx). Keep it short.
TENANT_DB_PREFIX=edu
# Connections per school database (pool_size + max_overflow). Multiply by the
# number of active schools to size MySQL's max_connections.
TENANT_POOL_SIZE=5
TENANT_MAX_OVERFLOW=5
# Shown in the dashboards: scheme and default API version for each school's URLs.
#   login URL  -> <scheme>://<tenant_id>.login.<TENANT_BASE_DOMAIN>
#   API URL    -> <scheme>://<tenant_id>.api.<TENANT_BASE_DOMAIN>/<API_DEFAULT_VERSION>
TENANT_URL_SCHEME=https
API_DEFAULT_VERSION=y26

# --- Production: behind nginx / a load balancer, on the internet ---
# Number of proxies in front of the app (usually 1). Makes the real host, https and
# client address be used. Leave unset only when nothing sits in front of the app.
TRUSTED_PROXY_COUNT=1
# How long a school's lookup is remembered, in seconds. Changes made in the
# developer console apply at once on the server that made them, and on the other
# gunicorn workers within this time. 0 turns the cache off.
TENANT_CACHE_SECONDS=30
# Brute-force protection on logins (failed attempts only). Set false to disable.
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILS_PER_ACCOUNT=8
LOGIN_MAX_FAILS_PER_IP=100
LOGIN_FAIL_WINDOW_SECONDS=300
# CORS: the addresses of every school (<school>.login.<TENANT_BASE_DOMAIN> and
# <school>.api.<TENANT_BASE_DOMAIN>) are allowed automatically. Use CORS_ORIGINS
# (above) only for other origins, comma separated. Remove localhost in production.

# --- Sign-in page images (uploaded logos, favicon, background) ---
# Folder on the server where uploaded branding images are kept. Back it up with the databases.
BRANDING_UPLOAD_DIR=

# --- Email (SMTP) ---
# Key that encrypts stored SMTP passwords. Generate once, keep it safe; losing it means
# passwords must be entered again:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_ENCRYPTION_KEY=
# Development only: allows mail servers on this machine (for example a local mail catcher)
# and unencrypted connections. Keep false in production.
SMTP_ALLOW_LOCAL=false
