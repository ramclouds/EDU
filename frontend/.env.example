# Copy to .env (or .env.production for a prod build) and set the real
# backend URL. Vite only exposes vars prefixed VITE_ to the browser.
VITE_API_BASE_URL=http://localhost:5000

# Email shown as the Support contact on the login page (optional).
VITE_SUPPORT_EMAIL=

# --- Production (one build serves every school) ---
# Your platform domain. The app finds its API from the address it is opened on:
#   https://apec.login.<domain>  ->  https://apec.api.<domain>
# Leave VITE_API_BASE_URL empty in production so this applies.
VITE_TENANT_BASE_DOMAIN=
VITE_TENANT_URL_SCHEME=https
# Put the API version in every API address, for example y26. Leave empty for /api.
VITE_API_VERSION=
